# Copy this file to server/.env and fill in the real values.
# Never commit server/.env. Never paste a real connection string into chat, code or docs.

# MongoDB connection string. Use a database user that can access ONLY the
# rhythm_runner database. It looks like:
#   mongodb+srv://USER:PASSWORD@your-cluster.mongodb.net/
MONGODB_URI=

# The database this project owns. Nothing else uses it.
MONGODB_DB_NAME=rhythm_runner

# Port the server listens on. The client dev server forwards /api here.
PORT=4000

# Optional. Unlocks GET /api/events/summary, the anonymous funnel. Any long
# random string. Without it that route answers 404 and simply does not exist.
ADMIN_KEY=
